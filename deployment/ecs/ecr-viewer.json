{
  "family": "ecr-viewer",
  "networkMode": "awsvpc",
  "requiresCompatibilities": ["FARGATE"],
  "cpu": "512",
  "memory": "1024",
  "executionRoleArn": "arn:aws:iam::123456789012:role/ecsExecutionRole",
  "taskRoleArn": "arn:aws:iam::123456789012:role/ecsTaskRole",
  "runtimePlatform": {
    "cpuArchitecture": "X86_64",
    "operatingSystemFamily": "LINUX"
  },
  "containerDefinitions": [
    {
      "name": "ecr-viewer",
      "image": "ghcr.io/cdcgov/dibbs-ecr-viewer/ecr-viewer:${IMAGE_TAG}",
      "portMappings": [
        {
          "containerPort": 3000,
          "hostPort": 3000,
          "protocol": "tcp"
        }
      ],
      "environment": [
        { "name": "PORT", "value": "3000" },
        { "name": "HOSTNAME", "value": "0.0.0.0" },
        { "name": "NEXT_TELEMETRY_DISABLED", "value": "1" },
        { "name": "APP_VERSION", "value": "${IMAGE_TAG}" },
        { "name": "DATABASE_URL", "value": "${DATABASE_URL}" },
        { "name": "ORCHESTRATION_URL", "value": "http://dibbs-orchestration:8080" },
        { "name": "DIBBS_VERSION", "value": "${DIBBS_VERSION}" },
        { "name": "CONFIG_NAME", "value": "${CONFIG_NAME}" },
        { "name": "METADATA_DATABASE_SCHEMA", "value": "${METADATA_DATABASE_SCHEMA}" },
        { "name": "SQL_SERVER_USER", "value": "${SQL_SERVER_USER}" },
        { "name": "SQL_SERVER_HOST", "value": "${SQL_SERVER_HOST}" },
        { "name": "DB_CIPHER", "value": "${DB_CIPHER}" },
        { "name": "AUTH_PROVIDER", "value": "${AUTH_PROVIDER}" },
        { "name": "AUTH_CLIENT_ID", "value": "${AUTH_CLIENT_ID}" },
        { "name": "AUTH_ISSUER", "value": "${AUTH_ISSUER}" },
        { "name": "AUTH_SESSION_DURATION_MIN", "value": "${AUTH_SESSION_DURATION_MIN}" },
        { "name": "NEXTAUTH_URL", "value": "${NEXTAUTH_URL}" },
        { "name": "SAVE_XML", "value": "${SAVE_XML}" },
        { "name": "DISPLAY_FEEDBACK_LINKS", "value": "${DISPLAY_FEEDBACK_LINKS}" },
        { "name": "ECR_PROCESSING_TIMEOUT", "value": "${ECR_PROCESSING_TIMEOUT}" },
        { "name": "AWS_REGION", "value": "${AWS_REGION}" },
        { "name": "ECR_BUCKET_NAME", "value": "${ECR_BUCKET_NAME}" },
        { "name": "AZURE_CONTAINER_NAME", "value": "${AZURE_CONTAINER_NAME}" },
        { "name": "GCP_PROJECT_ID", "value": "${GCP_PROJECT_ID}" },
        { "name": "NBS_API_PUB_KEY", "value": "${NBS_API_PUB_KEY}" },
        { "name": "NBS_PUB_KEY", "value": "${NBS_PUB_KEY}" }
      ],
      "secrets": [
        {
          "name": "AUTH_CLIENT_SECRET",
          "valueFrom": "arn:aws:secretsmanager:us-east-2:123456789012:secret:dibbs-ecr-viewer-AUTH_CLIENT_SECRET"
        },
        {
          "name": "NEXTAUTH_SECRET",
          "valueFrom": "arn:aws:secretsmanager:us-east-2:123456789012:secret:dibbs-ecr-viewer-NEXTAUTH_SECRET"
        },
        {
          "name": "DATABASE_URL",
          "valueFrom": "arn:aws:secretsmanager:us-east-2:123456789012:secret:dibbs-ecr-viewer-DATABASE_URL"
        },
        {
          "name": "METADATA_DATABASE_MIGRATION_SECRET",
          "valueFrom": "arn:aws:secretsmanager:us-east-2:123456789012:secret:dibbs-ecr-viewer-METADATA_DATABASE_MIGRATION_SECRET"
        },
        {
          "name": "SQL_SERVER_PASSWORD",
          "valueFrom": "arn:aws:secretsmanager:us-east-2:123456789012:secret:dibbs-ecr-viewer-SQL_SERVER_PASSWORD"
        },
        {
          "name": "AZURE_STORAGE_CONNECTION_STRING",
          "valueFrom": "arn:aws:secretsmanager:us-east-2:123456789012:secret:dibbs-ecr-viewer-AZURE_STORAGE_CONNECTION_STRING"
        }
      ],
      ],
      "healthCheck": {
        "command": [
          "CMD-SHELL",
          "wget --spider -q http://127.0.0.1:3000/api/health-check || exit 1"
        ],
        "interval": 30,
        "timeout": 5,
        "retries": 3,
        "startPeriod": 10
      },
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/ecr-viewer",
          "awslogs-create-group": "true",
          "awslogs-region": "us-east-2",
          "awslogs-stream-prefix": "ecr-viewer"
        }
      },
      "readonlyRootFilesystem": false,
      "stopTimeout": 30
    }
  ]
}
