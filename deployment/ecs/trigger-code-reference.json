{
  "family": "trigger-code-reference",
  "networkMode": "awsvpc",
  "requiresCompatibilities": ["FARGATE"],
  "cpu": "512",
  "memory": "1024",
  "executionRoleArn": "arn:aws:iam::123456789012:role/ecsExecutionRole",
  "taskRoleArn": "arn:aws:iam::123456789012:role/ecsTaskRole",
  "runtimePlatform": {
    "cpuArchitecture": "X86_64",
    "operatingSystemFamily": "LINUX"
  },
  "containerDefinitions": [
    {
      "name": "trigger-code-reference",
      "image": "ghcr.io/cdcgov/dibbs-ecr-viewer/trigger-code-reference:${IMAGE_TAG}",
      "portMappings": [
        {
          "containerPort": 8080,
          "hostPort": 8080,
          "protocol": "tcp"
        }
      ],
      "environment": [
        { "name": "INGESTION_URL", "value": "http://orchestration:8080" },
        { "name": "MESSAGE-PARSER_URL", "value": "http://message-parser:8080" },
        {
          "name": "TRIGGER_CODE_REFERENCE_URL",
          "value": "http://trigger-code-reference:8080"
        },
        { "name": "SMARTY_AUTH_ID", "value": "${SMARTY_AUTH_ID}" },
        { "name": "SMARTY_AUTH_TOKEN", "value": "${SMARTY_AUTH_TOKEN}" }
      ],
      "secrets": [
        {
          "name": "SMARTY_AUTH_ID",
          "valueFrom": "arn:aws:secretsmanager:us-east-2:123456789012:secret:dibbs-ecr-viewer-SMARTY_AUTH_ID"
        },
        {
          "name": "SMARTY_AUTH_TOKEN",
          "valueFrom": "arn:aws:secretsmanager:us-east-2:123456789012:secret:dibbs-ecr-viewer-SMARTY_AUTH_TOKEN"
        }
      ],
      "healthCheck": {
        "command": [
          "CMD-SHELL",
          "wget --spider -q http://127.0.0.1:8080/ || exit 1"
        ],
        "interval": 30,
        "timeout": 5,
        "retries": 3,
        "startPeriod": 10
      },
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/trigger-code-reference",
          "awslogs-create-group": "true",
          "awslogs-region": "us-east-2",
          "awslogs-stream-prefix": "trigger-code-reference"
        }
      },
      "readonlyRootFilesystem": false,
      "stopTimeout": 30
    }
  ]
}
