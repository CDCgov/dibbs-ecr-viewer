{
  "family": "orchestration",
  "networkMode": "awsvpc",
  "requiresCompatibilities": ["FARGATE"],
  "cpu": "512",
  "memory": "1024",
  "executionRoleArn": "arn:aws:iam::123456789012:role/ecsExecutionRole",
  "taskRoleArn": "arn:aws:iam::123456789012:role/ecsTaskRole",
  "runtimePlatform": {
    "cpuArchitecture": "X86_64",
    "operatingSystemFamily": "LINUX"
  },
  "containerDefinitions": [
    {
      "name": "orchestration",
      "image": "ghcr.io/cdcgov/dibbs-ecr-viewer/orchestration:${IMAGE_TAG}",
      "portMappings": [
        {
          "containerPort": 8080,
          "hostPort": 8080,
          "protocol": "tcp"
        }
      ],
      "environment": [
        {"name": "ECR_VIEWER_URL", "value": "http://dibbs-ecr-viewer:3000/ecr-viewer"},
        {"name": "FHIR_CONVERTER_URL", "value": "http://dibbs-fhir-converter:8080"},
        {"name": "INGESTION_URL", "value": "http://dibbs-ingestion:8080"},
        {"name": "MESSAGE_PARSER_URL", "value": "http://dibbs-message-parser:8080"},
        {"name": "OTEL_METRICS", "value": "none"},
        {"name": "OTEL_METRICS_EXPORTER", "value": "none"},
        {"name": "TRIGGER_CODE_REFERENCE_URL", "value": "http://dibbs-trigger-code-reference:8080"}
      ],
      "healthCheck": {
        "command": ["CMD-SHELL", "wget --spider -q http://127.0.0.1:8080/ || exit 1"],
        "interval": 30,
        "timeout": 5,
        "retries": 3,
        "startPeriod": 10
      },
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/orchestration",
          "awslogs-create-group": "true",
          "awslogs-region": "us-east-2",
          "awslogs-stream-prefix": "orchestration"
        }
      },
      "readonlyRootFilesystem": true,
      "stopTimeout": 30
    }
  ]
}
