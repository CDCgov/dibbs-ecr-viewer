{
  "name": "dibbs-ecr-viewer",
  "version": "1.0.0",
  "scripts": {
    "lint": "cd containers/ecr-viewer && eslint --ext=.ts,.tsx --fix . && cd ../..",
    "typecheck": "cd containers/ecr-viewer && tsc --noEmit && cd ../..",
    "migration:create": "cd containers/ecr-viewer && node scripts/create-migration.mjs"
  },
  "devDependencies": {
    "@dword-design/eslint-plugin-import-alias": "^8.1.8",
    "@next/eslint-plugin-next": "^16.4.5",
    "@typescript-eslint/eslint-plugin": "^8.72.1",
    "@typescript-eslint/parser": "^8.72.1",
    "eslint": "^10.14.0",
    "eslint-config-next": "^16.4.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsdoc": "^65.4.3",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-unused-imports": "^4.4.1",
    "typescript": "^6.0.3"
  },
  "overrides": {
    "glob@>=9 <14.0.2": "^14.0.2",
    "minimatch@>=7 <11.0.1": "^11.0.1",
    "eslint-plugin-import": {
      "eslint": "$eslint"
    },
    "eslint-plugin-react": {
      "eslint": "$eslint"
    }
  }
}
