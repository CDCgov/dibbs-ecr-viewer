{
  "ecr_id": {
    "fhir_path": "Bundle.id",
    "data_type": "string",
    "nullable": false
  },
  "set_id": {
    "fhir_path": "Bundle.entry.resource.where(resourceType= 'Composition').identifier.where(type.coding.code = '55751-2').where(use='official').value",
    "data_type": "string",
    "nullable": true
  },
  "eicr_version_number": {
    "fhir_path": "Bundle.entry.resource.where(resourceType= 'Composition' ).extension.where(url='http://hl7.org/fhir/StructureDefinition/composition-clinicaldocument-versionNumber').valueString",
    "data_type": "string",
    "nullable": true
  },
  "last_name": {
    "fhir_path": "Bundle.entry.resource.where(resourceType = 'Patient').name.first().family",
    "data_type": "string",
    "nullable": true,
    "metadata": {
      "category": "Personal info"
    }
  },
  "first_name": {
    "fhir_path": "Bundle.entry.resource.where(resourceType = 'Patient').name.first().given.first()",
    "data_type": "string",
    "nullable": true,
    "metadata": {
      "category": "Personal info"
    }
  },
  "birth_date": {
    "fhir_path": "Bundle.entry.resource.where(resourceType = 'Patient').birthDate",
    "data_type": "date",
    "nullable": true,
    "metadata": {
      "category": "Personal info"
    }
  },
  "encounter_start_date": {
    "fhir_path": "Bundle.entry.resource.where(resourceType = 'Encounter' and id = %ref).period.start",
    "data_type": "date",
    "nullable": true,
    "reference_lookup": "Bundle.entry.resource.where(resourceType = 'Composition').encounter.reference",
    "metadata": {
      "category": "RR Reportability Information"
    }
  },
  "rr": {
    "fhir_path": "Bundle.entry.resource.where(resourceType = 'Observation').where(code.coding.exists(system = 'http://loinc.org' and code = '75323-6'))",
    "data_type": "array",
    "nullable": true,
    "secondary_schema": {
      "uuid": {
        "fhir_path": "Observation.id",
        "data_type": "string",
        "nullable": true,
        "metadata": {
          "category": "RR Reportability Information"
        }
      },
      "condition": {
        "fhir_path": "iif(Observation.valueCodeableConcept.text.exists(), Observation.valueCodeableConcept.text, Observation.valueCodeableConcept.coding.display)",
        "data_type": "string",
        "nullable": true,
        "metadata": {
          "category": "RR Reportability Information"
        }
      },
      "condition_code": {
        "fhir_path": "iif(Observation.valueCodeableConcept.text.exists(), Observation.valueCodeableConcept.coding.where(system = 'http://snomed.info/sct').code)",
        "data_type": "string",
        "nullable": true,
        "metadata": {
          "category": "RR Reportability Information"
        }
      },
      "rule_summaries": {
        "fhir_path": "Bundle.entry.resource.where(resourceType = 'Observation').where(id = %ref).extension.where(url = 'http://hl7.org/fhir/us/ecr/StructureDefinition/us-ph-determination-of-reportability-rule-extension')",
        "data_type": "array",
        "nullable": true,
        "reference_lookup": "Observation.hasMember.reference",
        "secondary_schema": {
          "rule_summary": {
            "fhir_path": "valueString",
            "data_type": "string",
            "nullable": true
          }
        },
        "metadata": {
          "category": "RR Reportability Information"
        }
      }
    }
  }
}
