{
  "name": "ecr-viewer",
  "description": "The DIBBs eCR Viewer app offers a REST API for processing FHIR messages into an HTML page with key insights.",
  "private": true,
  "engines": {
    "node": "^26",
    "npm": "^11"
  },
  "scripts": {
    "dev": "next dev",
    "local-dev": "npx @dotenvx/dotenvx run -f .env.local -- sh -c 'docker compose -f ./docker-compose.yaml --profile ${CONFIG_NAME} up -d && allow-scripts && npm run dev'",
    "local-docker": "npx @dotenvx/dotenvx run -f .env.local -- sh -c 'docker compose -f ./docker-compose.yaml --profile ${CONFIG_NAME} --profile ecr-viewer up ${FLAGS}'",
    "local-docker:build": "FLAGS=--build npm run local-docker",
    "local-docker:silent": "FLAGS=-d npm run local-docker",
    "setup-local-env": "../../setup-env.sh .env.local",
    "build": "next build --webpack",
    "build:analyze": "ANALYZE=true next build",
    "start": "next start",
    "lint": "eslint .",
    "lint:tsc": "tsc --noEmit",
    "format": "prettier --write '**/*.{js,json,md,ts,tsx,scss,yaml,yml}'",
    "format:check": "prettier --check '**/*.{js,json,md,ts,tsx,scss,yaml,yml}'",
    "test": "TZ=America/New_York jest",
    "test:watch": "TZ=America/New_York jest --watch",
    "test:integration:pg": "npx @dotenvx/dotenvx run -f .env.local -- sh -c 'METADATA_DATABASE_TYPE=postgres TEST_TYPE=integration TZ=America/New_York jest --runInBand --detectOpenHandles'",
    "test:integration:sqlserver": "npx @dotenvx/dotenvx run -f .env.local -- sh -c 'METADATA_DATABASE_TYPE=sqlserver TEST_TYPE=integration TZ=America/New_York jest --runInBand --detectOpenHandles'",
    "test:e2e:install": "playwright install --with-deps",
    "test:e2e": "npx @dotenvx/dotenvx run -f .env.local -- playwright test --project chromium --project firefox --project webkit",
    "test:e2e:migrations": "npx @dotenvx/dotenvx run -f .env.local -- playwright test --project migrations",
    "test:e2e:seed-user-prog": "npx @dotenvx/dotenvx run -f .env.local -- playwright test --project seed",
    "test:load": "npx @dotenvx/dotenvx run -f .env.local -- sh -c 'docker compose -f ./seed-scripts/docker-compose-load.yaml --profile ${CONFIG_NAME} up --build'",
    "test:load:local": "npx @dotenvx/dotenvx run -f .env.local -- sh -c 'docker compose -f ./seed-scripts/docker-compose-load-local.yaml --profile ${CONFIG_NAME} --profile ecr-viewer up --build'",
    "clear-local": "docker compose -f ./seed-scripts/docker-compose-seed.yaml --profile \"*\" down -v",
    "convert-seed-data": "npx @dotenvx/dotenvx run -f .env.local -- sh -c 'docker compose -f ./seed-scripts/docker-compose-seed.yaml --profile ${CONFIG_NAME} --profile ecr-viewer up --abort-on-container-exit ${CONVERT_FLAGS}'",
    "convert-seed-data:build": "CONVERT_FLAGS=--build npm run convert-seed-data",
    "migration:create": "node scripts/create-migration.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1127.0",
    "@azure/storage-blob": "^12.33.0",
    "@fullhuman/postcss-purgecss": "^8.0.0",
    "@google-cloud/storage": "^8.1.0",
    "@next/bundle-analyzer": "^16.3.4",
    "@parcel/watcher": "2.6.0",
    "@trussworks/react-uswds": "^10.0.2",
    "@uswds/uswds": "^3.14.0",
    "classnames": "^2.5.1",
    "fhirpath": "5.2.0",
    "focus-trap-react": "^12.0.3",
    "html-react-parser": "^6.1.7",
    "jose": "6.1.0",
    "js-cookie": "^3.0.8",
    "jszip": "^3.10.1",
    "kysely": "^0.28.17",
    "luxon": "^3.7.1",
    "motion": "^13.2.0",
    "mssql": "^12.7.0",
    "next": "16.3.4",
    "next-auth": "^4.24.15",
    "node-html-parser": "^9.0.3",
    "pg": "^8.23.0",
    "postcss-discard-comments": "^9.0.1",
    "postcss-flexbugs-fixes": "^5.0.2",
    "postcss-preset-env": "^11.5.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-xml-viewer": "^3.0.5",
    "sanitize-html": "^2.17.7",
    "saxes": "^6.0.0",
    "server-only": "^0.0.1",
    "sharp": "^0.35.4",
    "tarn": "^3.1.2",
    "tedious": "^20.0.0",
    "undici": "^8.10.2",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@dotenvx/dotenvx": "^2.23.0",
    "@dword-design/eslint-plugin-import-alias": "^8.1.8",
    "@eslint/compat": "^2.1.1",
    "@eslint/eslintrc": "^3.3.7",
    "@eslint/js": "^10.0.1",
    "@lavamoat/allow-scripts": "^5.1.0",
    "@lavamoat/preinstall-always-fail": "^3.0.0",
    "@next/eslint-plugin-next": "^16.3.4",
    "@playwright/test": "^1.63.0",
    "@smithy/util-stream": "^4.8.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/fhir": "^0.0.41",
    "@types/jest": "^30.0.0",
    "@types/jest-axe": "^3.5.9",
    "@types/js-cookie": "^3.0.6",
    "@types/luxon": "^3.7.5",
    "@types/mssql": "^12.3.0",
    "@types/node": "^26.4.1",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@types/sanitize-html": "^2.16.0",
    "@types/tedious": "^4.0.14",
    "@typescript-eslint/eslint-plugin": "^8.69.0",
    "@typescript-eslint/parser": "^8.69.0",
    "autoprefixer": "^10.5.5",
    "aws-sdk-client-mock": "^4.1.0",
    "concurrently": "^10.0.5",
    "eslint": "^10.10.0",
    "eslint-config-next": "^16.3.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsdoc": "^64.3.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-unused-imports": "^4.4.1",
    "get-port": "^7.2.0",
    "globals": "^17.12.0",
    "jest": "^30.5.1",
    "jest-axe": "^11.0.0",
    "jest-environment-jsdom": "^30.5.1",
    "jest-extended": "^7.0.0",
    "jest-fail-on-console": "^3.3.1",
    "lighthouse": "^13.4.1",
    "next-router-mock": "^1.0.2",
    "playwright-lighthouse": "^4.0.0",
    "postcss": "^8.5.28",
    "prettier": "^3.9.6",
    "react-is": "^19.2.8",
    "sass": "^1.104.0",
    "typescript": "^6.0.3"
  },
  "overrides": {
    "@lavamoat/allow-scripts": {
      "yargs": "^18"
    },
    "@trussworks/react-uswds": {
      "focus-trap-react": "$focus-trap-react"
    },
    "pretty-format": {
      "react-is": "$react-is"
    },
    "eslint-plugin-import": {
      "eslint": "$eslint"
    },
    "eslint-plugin-react": {
      "eslint": "$eslint"
    },
    "eslint-plugin-jsx-a11y": {
      "eslint": "$eslint"
    },
    "fast-xml-parser": "5.11.1",
    "test-exclude": "7.0.1",
    "uuid": "^14.0.2"
  },
  "lavamoat": {
    "allowScripts": {
      "@lavamoat/preinstall-always-fail#3.0.0": false,
      "@parcel/watcher#2.6.0": true,
      "eslint-config-next>eslint-import-resolver-typescript>unrs-resolver#1.12.2": true,
      "fhirpath#5.2.0": false,
      "next>sharp#0.34.5": true,
      "sharp#0.34.5": true
    }
  }
}
